@model List<SP500StocksApp.Models.Stock>
@{
    ViewData["Title"] = "Live Quotes";
}

<style>
    .stock-chart-container {
        display: none;
        margin-top: 15px;
        margin-bottom: 15px;
        padding: 15px;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    .stock-chart-container.active {
        display: block;
    }
    .toggle-chart-btn {
        cursor: pointer;
        margin-left: 10px;
        font-size: 0.9rem;
    }
    .toggle-chart-btn:hover {
        opacity: 0.7;
    }
    canvas {
        max-height: 300px;
        width: 100%;
    }
    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }
</style>

<h1>Real-Time S&P 500 Quotes</h1>
<p class="text-muted">Click the chart icon next to any stock to view price history</p>

<table id="quotesTable" class="table table-striped">
    <thead>
        <tr>
            <th>Chart</th>
            <th>Symbol</th>
            <th>Company</th>
            <th>Sector</th>
            <th>Price</th>
            <th>Change</th>
            <th>Change %</th>
            <th>Volume</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var stock in Model)
        {
            <tr id="row-@stock.Symbol">
                <td>
                    <i class="fas fa-chart-line toggle-chart-btn text-primary" 
                       data-symbol="@stock.Symbol"
                       data-name="@stock.Name"
                       style="cursor: pointer; font-size: 1.2rem;"
                       title="View price chart for @stock.Symbol"></i>
                </td>
                <td><strong>@stock.Symbol</strong></td>
                <td>@stock.Name</td>
                <td>@stock.Sector</td>
                <td>$@stock.Price.ToString("F2")</td>
                <td class="@(stock.Change >= 0 ? "positive" : "negative")">
                    @(stock.Change >= 0 ? "+" : "")$@stock.Change.ToString("F2")
                </td>
                <td class="@(stock.ChangePercent >= 0 ? "positive" : "negative")">
                    @(stock.ChangePercent >= 0 ? "+" : "")@stock.ChangePercent.ToString("F2")%
                </td>
                <td>@stock.Volume.ToString("N0")</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <style>
        .positive { color: #28a745; font-weight: bold; }
        .negative { color: #dc3545; font-weight: bold; }
    </style>
    
    <script>
        // Store chart instances to avoid recreating
        const chartInstances = {};
        
        $(document).ready(function() {
            // Initialize DataTable
            const table = $('#quotesTable').DataTable({
                pageLength: 25,
                order: [[1, 'asc']],
                language: {
                    search: "Search within results:"
                }
            });
            
            // Handle chart button clicks
            $('.toggle-chart-btn').click(async function() {
                const symbol = $(this).data('symbol');
                const companyName = $(this).data('name');
                const icon = $(this);
                const row = $(`#row-${symbol}`);
                
                // Check if chart container already exists
                let chartContainer = row.next('.stock-chart-container');
                
                if (chartContainer.length === 0) {
                    // Create new chart container
                    chartContainer = $(`
                        <tr class="stock-chart-container">
                            <td colspan="8">
                                <div class="chart-header">
                                    <strong>${companyName} (${symbol}) - 30 Day Price History</strong>
                                    <i class="fas fa-times-circle close-chart" style="cursor: pointer; color: #dc3545;"></i>
                                </div>
                                <canvas id="chart-${symbol}"></canvas>
                            </td>
                        </tr>
                    `);
                    
                    // Insert after current row
                    row.after(chartContainer);
                    chartContainer.addClass('active');
                    
                    // Show loading indicator
                    const canvas = chartContainer.find(`#chart-${symbol}`);
                    canvas.after('<div class="chart-loading">Loading chart data...</div>');
                    
                    // Fetch chart data
                    try {
                        const response = await fetch(`/Home/GetStockChart?symbol=${symbol}&days=30`);
                        const data = await response.json();
                        
                        // Remove loading indicator
                        canvas.next('.chart-loading').remove();
                        
                        // Create chart
                        const ctx = canvas[0].getContext('2d');
                        chartInstances[symbol] = new Chart(ctx, {
                            type: 'line',
                            data: {
                                labels: data.dates,
                                datasets: [
                                    {
                                        label: 'Close Price',
                                        data: data.closes,
                                        borderColor: 'rgb(75, 192, 192)',
                                        backgroundColor: 'rgba(75, 192, 192, 0.1)',
                                        tension: 0.1,
                                        fill: true,
                                        yAxisID: 'y'
                                    },
                                    {
                                        label: 'Volume (Millions)',
                                        data: data.volumes.map(v => v / 1000000),
                                        borderColor: 'rgba(153, 102, 255, 0.5)',
                                        backgroundColor: 'rgba(153, 102, 255, 0.1)',
                                        type: 'bar',
                                        yAxisID: 'y1'
                                    }
                                ]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: true,
                                interaction: {
                                    mode: 'index',
                                    intersect: false
                                },
                                plugins: {
                                    tooltip: {
                                        callbacks: {
                                            label: function(context) {
                                                let label = context.dataset.label || '';
                                                let value = context.raw;
                                                if (context.dataset.label === 'Volume (Millions)') {
                                                    return `${label}: ${value.toFixed(2)}M`;
                                                }
                                                return `${label}: $${value.toFixed(2)}`;
                                            }
                                        }
                                    },
                                    legend: {
                                        position: 'top'
                                    }
                                },
                                scales: {
                                    y: {
                                        title: {
                                            display: true,
                                            text: 'Price ($)'
                                        },
                                        beginAtZero: false
                                    },
                                    y1: {
                                        title: {
                                            display: true,
                                            text: 'Volume (Millions)'
                                        },
                                        position: 'right',
                                        grid: {
                                            drawOnChartArea: false
                                        }
                                    }
                                }
                            }
                        });
                    } catch (error) {
                        canvas.next('.chart-loading').remove();
                        canvas.after('<div class="text-danger">Error loading chart data</div>');
                    }
                    
                    // Handle close button
                    chartContainer.find('.close-chart').click(function() {
                        // Destroy chart instance
                        if (chartInstances[symbol]) {
                            chartInstances[symbol].destroy();
                            delete chartInstances[symbol];
                        }
                        chartContainer.remove();
                    });
                    
                } else {
                    // Toggle existing chart
                    if (chartContainer.hasClass('active')) {
                        chartContainer.removeClass('active');
                        // Optional: keep chart instance for faster reopening
                    } else {
                        chartContainer.addClass('active');
                        // Refresh chart if needed
                        if (chartInstances[symbol]) {
                            chartInstances[symbol].update();
                        }
                    }
                }
            });
        });
    </script>
}